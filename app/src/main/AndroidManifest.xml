<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      BorrowNest declares NO permissions. It is fully offline and requests no
      runtime permissions. In particular it does NOT declare INTERNET,
      READ_CONTACTS, WRITE_CONTACTS, CAMERA, POST_NOTIFICATIONS, location,
      microphone, storage, calendar, Bluetooth, NFC, SMS, or alarm permissions.
    -->

    <application
        android:name=".BorrowNestApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BorrowNest.Starting"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|fontScale"
            android:theme="@style/Theme.BorrowNest.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
